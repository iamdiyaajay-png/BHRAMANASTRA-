# BHRAMANASTHRA Frontend Environment Configuration
# Copy this file to .env and fill in your actual API keys.
# DO NOT commit .env to version control!

# MapTiler API Key (Used for MapTiler dataviz-dark tiles)
# Register for a free key at: https://cloud.maptiler.com/
VITE_MAPTILER_KEY=YOUR_MAPTILER_API_KEY_HERE

# Proposed FastAPI Backend Base URL
VITE_API_BASE_URL=http://localhost:8000
